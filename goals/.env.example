# GOALS · environment variables
# Copy to .env.local for local development (never commit .env.local).
# In Vercel, set the same names under Project Settings → Environment Variables.

# --- Supabase (public: safe in the browser, protected by RLS) -----------------
# Supabase dashboard → Project Settings → API. Locally: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --- Access ------------------------------------------------------------------
# The only account allowed into GOALS (also add it to the DB allowlist, see README).
OWNER_EMAIL=you@example.com

# --- Claude (server only; never NEXT_PUBLIC_) --------------------------------
# console.anthropic.com → API Keys. Leave empty to run GOALS without AI.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Future integrations (not active yet; see README › Integraciones) -------
# MAKE_WEBHOOK_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Only for scripts/create-owner.mjs, run on your machine. -----------------
# Do NOT add this to Vercel: the app never needs it.
# SUPABASE_SECRET_KEY=
