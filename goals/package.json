{
  "name": "goals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:e2e": "tests/e2e/run-local.sh",
    "mock:ai": "node tests/e2e/mock-anthropic.mjs",
